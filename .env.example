# Digibuddy local development only.
# Copy this file to .env and change local-only values as needed.
# Never use these defaults in a hosted or production environment.

PORT=8080

POSTGRES_DB=digibuddy_dev
POSTGRES_USER=digibuddy_dev
POSTGRES_PASSWORD=digibuddy_local_only
DATABASE_JDBC_URL=jdbc:postgresql://localhost:5432/digibuddy_dev

REDIS_URL=redis://localhost:6379

# Authentication. The example values are deliberately local-only.
DIGIBUDDY_ENVIRONMENT=local-development
AUTH_OTP_PROVIDER=development
AUTH_REPOSITORY=memory
AUTH_TOKEN_PEPPER=replace-with-a-long-random-local-development-value
AUTH_IDENTIFIER_KEY=replace-with-a-different-long-random-local-development-value

# Development adapter placeholders. Leave blank until a sandbox integration is intentionally configured.
# These values are not required for /health or foundational tests.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.digibuddy.customer
APNS_PRIVATE_KEY_PATH=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=digibuddy-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
