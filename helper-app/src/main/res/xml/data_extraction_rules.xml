<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for DigiBuddy Helper app.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude DataStore preferences containing auth tokens from cloud backup -->
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Allow app data on device-to-device transfer except sensitive prefs -->
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
