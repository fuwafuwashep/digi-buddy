<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme -->
    <style name="Theme.Digibuddy" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen theme (shows teal background with icon) -->
    <style name="Theme.Digibuddy.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#009688</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Digibuddy</item>
    </style>
</resources>